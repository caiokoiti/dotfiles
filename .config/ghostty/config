theme = dracula

background = 000000

background-opacity = 0.95
# background-blur = 20  # Disabled - causes significant performance issues

window-padding-x = 10
window-padding-y = 10
window-padding-balance = true

font-size = 15
font-family = JetBrainsMono Nerd Font Mono

confirm-close-surface = false
maximize = true

macos-icon-frame = beige

# ── Keybinds ──────────────────────────────────────────────────────────────────
# Clear all Ghostty defaults — using native macOS shortcuts only.
keybind = clear
keybind = ctrl+shift+p=toggle_command_palette
keybind = super+left=ignore
keybind = super+right=ignore
